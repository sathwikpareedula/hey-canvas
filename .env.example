# Copy this file to .env and fill in values locally.
# Never commit .env or send its contents through chat, screenshots, or logs.

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/uta_academic_copilot.db
ACADEMIC_TIMEZONE=America/Chicago
ACADEMIC_FILES_ROOT=data/files
MAX_CANVAS_FILE_BYTES=104857600
CANVAS_FILE_METADATA_CONCURRENCY=5
SYNC_RUN_STALE_MINUTES=30
MAX_DOCUMENT_CHARACTERS=2000000
MAX_DOCUMENT_UNITS=2000
MAX_DOCUMENT_UNIT_CHARACTERS=100000
MAX_DOCUMENT_ARCHIVE_ENTRIES=5000
MAX_DOCUMENT_ARCHIVE_UNCOMPRESSED_BYTES=209715200
MAX_DOCUMENT_ARCHIVE_RATIO=200
ACADEMIC_MODEL_PROVIDER=synthetic
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
ASSISTANT_REQUEST_TIMEOUT_SECONDS=20

# Canvas setup is documented in README.md. Keep the token server-side only.
CANVAS_BASE_URL=https://uta.instructure.com
CANVAS_TOKEN=
# Optional: LOCAL_API_GUARD_ENABLED=true (default). Set false only for specialized local debugging.
# Optional: HEY_CANVAS_CREDENTIAL_STORE for isolated DPAPI test path.
# API_BIND_HOST=127.0.0.1
# API_ALLOW_REMOTE_BIND=false
