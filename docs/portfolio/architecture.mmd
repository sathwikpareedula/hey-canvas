graph TD
    %% Hey Canvas V1.2 System Architecture Diagram
    %% Local-First, Privacy-Preserving Academic Copilot

    subgraph ClientLayer ["Client Presentation Layer (Next.js 16 + React 19)"]
        UI_Dash["Academic Dashboard & Courses"]
        UI_Chat["Hey Canvas Workspace (SSE Streaming)"]
        UI_Cal["Deadline & Schedule Calendar"]
        UI_Storage["Managed Storage Inspector Panel"]
        UI_Voice["Voice Interface (Web Speech API)"]
    end

    subgraph ProcessBoundary ["Windows Process & Isolation Boundary (Loopback 127.0.0.1)"]
        Launcher["PowerShell Launcher (Start-HeyCanvas.ps1)<br/>Tracked PIDs, Start Times, Health Probes"]
        CORS["Strict Loopback CORS & CSRF Shield"]
    end

    subgraph BackendLayer ["Application Core (FastAPI + Python 3.12)"]
        Router["Intent Router & Fast-Path Dispatcher"]
        
        subgraph ConcurrencyControl ["Concurrency & Stream Lifecycle Management"]
            Shield["asyncio.shield Concurrency Guard"]
            Barrier["setup_finished Thread Event Barrier"]
            Abort["Immediate Socket Abort Handler (0.30ms)"]
        end

        subgraph IngestionEngine ["Academic Knowledge & Ingestion Pipeline"]
            DocPrep["On-Demand Document Ingestion (PDF / DOCX)"]
            DocIndex["Course-Scoped Document Index & Invalidation"]
            Coverage["Coverage Reporting Engine (/api/courses/{id}/document-coverage)"]
        end

        subgraph StorageService ["Managed Storage & State Engine"]
            StorageMgr["Storage Service (/api/storage/*)"]
            PathGuard["Path Traversal & DB Protection Shield"]
        end
    end

    subgraph LocalStorage ["Deterministic Persistence (Local Disk)"]
        SQL["Local SQLite Database (Read-Only Canvas Mirror)<br/>Courses, Syllabi, Assignments, Modules, Announcements"]
        Files["Managed Course Documents & Cache (/data/courses)"]
    end

    subgraph LocalAI ["Local On-Device AI Engine (Ollama Loopback)"]
        OllamaDaemon["Ollama Daemon (http://127.0.0.1:11434)"]
        Model["Llama 3.2 3B Instruct (GGUF Q4_K_M)"]
        ContextAssembler["Academic Context & Evidence Assembler"]
    end

    subgraph ExternalServices ["External Systems (Read-Only)"]
        CanvasAPI["UTA Canvas LMS REST API<br/>(Strict Read-Only Synchronization)"]
    end

    %% Client Interactions
    UI_Dash -->|REST /api/courses, /api/deadlines| Router
    UI_Chat -->|SSE Stream /api/assistant/stream| Router
    UI_Storage -->|REST /api/storage/summary| StorageMgr
    UI_Voice --> UI_Chat

    %% Process & Network Security
    Launcher -.->|Supervises| BackendLayer
    Launcher -.->|Supervises| ClientLayer
    Launcher -.->|Supervises| OllamaDaemon
    ClientLayer <--> CORS <--> BackendLayer

    %% Router Decision Engine
    Router -->|Deterministic Fast-Path (<1.3s)| SQL
    Router -->|Context & Pedagogical Query| ContextAssembler

    %% Concurrency & Safety Flow
    Router --> Shield
    Shield --> Barrier
    Barrier --> Abort

    %% Ingestion & Document Flow
    ContextAssembler --> DocIndex
    DocIndex --> DocPrep
    DocPrep --> Files
    DocIndex --> Coverage

    %% Storage Management
    StorageMgr --> PathGuard
    PathGuard --> Files
    PathGuard -.->|Protects from deletion| SQL

    %% Sync Pipeline
    CanvasAPI -->|ETag & Sync Token| IngestionEngine
    IngestionEngine --> SQL

    %% Model Inference
    ContextAssembler -->|Augmented Prompt + Course Citations| OllamaDaemon
    OllamaDaemon --> Model
    Model -->|Token Stream| Barrier
    Barrier -->|SSE Generator| UI_Chat
